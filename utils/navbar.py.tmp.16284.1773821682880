"""
utils/navbar.py
---------------
Shared top navigation bar for all WinRich Streamlit pages.

Usage (after require_login(), before any page content):

    from utils.navbar import navbar
    navbar()
"""

import streamlit as st


# Pages visible to every logged-in user
_NAV_PAGES = [
    ("📊 Portfolio Analysis",   "pages/generate_portfolio_analysis.py"),
    ("📨 Report Campaign",       "pages/manage_mfreport_campaign.py"),
    ("🏆 Fund Rankings",         "pages/view winrich fund ranks.py"),
    ("🔗 Benchmark Mapping",     "pages/view_fund__benchmark_mapping.py"),
    ("📈 NSE Indices",           "pages/view_NSE_indices.py"),
]

# Pages only visible to admins
_ADMIN_PAGES = [
    ("⚙️ Configuration",        "pages/manage_config.py"),
]


def navbar(current_page: str = "") -> None:
    """
    Render a sticky top navigation bar.

    Parameters
    ----------
    current_page : str
        Pass __file__ from the calling page so the current page button
        can be highlighted (optional).
    """
    st.markdown("""
        <style>
            /* Remove default top padding that Streamlit adds */
            .block-container { padding-top: 0.5rem !important; }
            div[data-testid="stHorizontalBlock"] .stButton button {
                border-radius: 6px;
                font-size: 13px;
                padding: 4px 8px;
                height: 36px;
            }
        </style>
    """, unsafe_allow_html=True)

    role = st.session_state.get("role", "")
    user_name = st.session_state.get("name", "User")

    pages = _NAV_PAGES + (_ADMIN_PAGES if role == "admin" else [])
    # +2 for Home and Logout
    cols = st.columns([0.8] + [1] * len(pages) + [0.8, 0.9])

    with cols[0]:
        if st.button("🏠 Home", key="nav_home", use_container_width=True):
            st.switch_page("login.py")

    for i, (label, path) in enumerate(pages):
        with cols[i + 1]:
            if st.button(label, key=f"nav_{i}", use_container_width=True):
                st.switch_page(path)

    with cols[-2]:
        st.markdown(
            f"<div style='text-align:center;font-size:12px;padding-top:8px;"
            f"color:#555'>👤 {user_name}</div>",
            unsafe_allow_html=True,
        )

    with cols[-1]:
        if st.button("🚪 Logout", key="nav_logout", use_container_width=True):
            for key in list(st.session_state.keys()):
                del st.session_state[key]
            st.switch_page("login.py")

    st.divider()
