"""
customer_portfolio.py
---------------------
Extends get_customer_portfolio() to enrich each Equity row in the
customer's portfolio with benchmark index return data via SchemeLookup.

Lookup logic per row:
  - Only rows where Nature == 'Equity' are looked up.
  - s_name is split on '-' and the part BEFORE the first '-' is used
    as the search query.
    e.g.  "Axis Midcap Fund - Growth"  →  query: "Axis Midcap Fund"
  - Non-Equity rows get None in all benchmark columns.

Expected customer DataFrame columns:
    h_name, c_name, sCode, s_name, foliono, Nature, FolioStartDate,
    BalUnit, AvgCost, InvAmt, TotalInvAmt, CurNAV, CurValue, DivAmt,
    NotionalGain, ActualGain, FolioXIRR, NatureXIRR, ClientXIRR,
    NatureAbs, ClientAbs, absReturn, ValueDate, ReportDate, Email, Mobile

New columns appended after enrichment:
    matched_scheme_name   — exact scheme name found in SchemeData CSV
    scheme_type           — e.g. "Open Ended"
    scheme_category       — e.g. "Equity Scheme - Large Cap Fund"
    benchmark_index       — e.g. "Nifty 50"
    benchmark_return_1m   — 1-month return (%)
    benchmark_return_3m   — 3-month return (%)
    benchmark_return_1yr  — 1-year return (%)
    benchmark_return_3yr  — 3-year return (%)
    benchmark_return_5yr  — 5-year return (%)
    lookup_error          — error string if lookup failed, else None
"""

from __future__ import annotations

from pathlib import Path
import re
from typing import Optional

import pandas as pd

from utils.Indices_lookup import SchemeLookup, LookupResult


# ── Benchmark column names ────────────────────────────────────────────────────
_BENCHMARK_COLS = [
    "matched_scheme_name",
    "scheme_type",
    "scheme_category",
    "benchmark_index",
    "benchmark_return_1m",
    "benchmark_return_3m",
    "benchmark_return_1yr",
    "benchmark_return_3yr",
    "benchmark_return_5yr",
    "lookup_error",
]


def _result_to_row(result: LookupResult) -> dict:
    """Map a LookupResult to the benchmark column dict."""
    return {
        "matched_scheme_name":  result.scheme_name,
        "scheme_type":          result.scheme_type,
        "scheme_category":      result.scheme_category,
        "benchmark_index":      result.index_name,
        "benchmark_return_1m":  result.return_1m,
        "benchmark_return_3m":  result.return_3m,
        "benchmark_return_1yr": result.return_1yr,
        "benchmark_return_3yr": result.return_3yr,
        "benchmark_return_5yr": result.return_5yr,
        "lookup_error":         None,
    }


def _empty_row(error_msg: Optional[str] = None) -> dict:
    """Return a blank benchmark row, with an optional error message."""
    return {col: None for col in _BENCHMARK_COLS} | {"lookup_error": error_msg}


# ══════════════════════════════════════════════════════════════════════════════
# Core function
# ══════════════════════════════════════════════════════════════════════════════

def get_customer_portfolio(
    df:            pd.DataFrame,
    customer_name: str,
    *,
    lookup:        Optional[SchemeLookup] = None,
    scheme_csv:    Optional[Path] = None,
    mapping_json:  Optional[Path] = None,
) -> pd.DataFrame:
    """
    Get portfolio data for a specific customer, enriched with benchmark
    index return values for every Equity row via SchemeLookup.

    Parameters
    ----------
    df : pd.DataFrame
        Full portfolio DataFrame containing all customers.
    customer_name : str
        Value to match against the 'c_name' column.
    lookup : SchemeLookup, optional
        Pre-initialised SchemeLookup instance. Reuse across multiple
        calls to avoid reloading files on every invocation.
    scheme_csv, mapping_json, parquet_dir : Path, optional
        Override default file paths forwarded to SchemeLookup.

    Returns
    -------
    pd.DataFrame
        Customer's portfolio rows with benchmark columns appended.
        Non-Equity rows and failed lookups have None in benchmark columns;
        failed lookups also have a message in 'lookup_error'.
    """

    # ── 1. Filter to this customer ────────────────────────────────────────────
    customer_df = df[df["c_name"] == customer_name].copy()

    if customer_df.empty:
        raise ValueError(f"No records found for customer '{customer_name}'.")

    # ── 2. Build (or reuse) the SchemeLookup instance ────────────────────────
    kwargs = {}
    if scheme_csv:   kwargs["scheme_csv"]   = scheme_csv
    if mapping_json: kwargs["mapping_json"] = mapping_json

    _lookup = lookup or SchemeLookup(**kwargs)

    # ── 3. Enrich each row ────────────────────────────────────────────────────
    enrichment_rows = []

    for _, row in customer_df.iterrows():

        # Skip non-Equity rows
        if str(row.get("Nature", "")).strip().lower() != "equity":
            enrichment_rows.append(_empty_row())
            continue

        # Split s_name on '-', use the part before the first '-'
        raw_name = str(row.get("s_name", ""))

        # Remove (Erstwhile ...) and (formerly ...)
        cleaned = re.sub(r"\(.*?Erstwhile.*?\)", "", raw_name, flags=re.IGNORECASE)
        cleaned = re.sub(r"\(.*?formerly.*?\)", "", cleaned, flags=re.IGNORECASE)

        # Remove growth/regular
        cleaned = re.sub(r"\b(growth|regular)\b", "", cleaned, flags=re.IGNORECASE)
        # Remove trailing orphan words
        cleaned = re.sub(r"\b(plan|option)\b", "", cleaned, flags=re.IGNORECASE)
        # Collapse multiple spaces
        cleaned = re.sub(r"\s+", " ", cleaned).strip()
        # Normalize hyphens
        cleaned = re.sub(r"\s*-\s*", " - ", cleaned)
        query = cleaned.split("-")[0].strip()

        if not query:
            enrichment_rows.append(_empty_row(f"Empty s_name: '{raw_name}'"))
            continue

        try:
            result = _lookup.find(query)
            enrichment_rows.append(_result_to_row(result))
        except Exception as e:
            enrichment_rows.append(_empty_row(str(e)))

    # ── 4. Concat benchmark columns onto customer_df ──────────────────────────
    enrichment_df = pd.DataFrame(enrichment_rows, index=customer_df.index)
    customer_df   = pd.concat([customer_df, enrichment_df], axis=1)

    return customer_df


